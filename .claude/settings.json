{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local*)",
      "Read(./.env.production*)",
      "Read(./.env.development*)",
      "Read(./.env.test*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf *)",
      "Bash(pnpm db:push*)",
      "Bash(pnpm drizzle-kit drop*)",
      "Bash(pnpm exec drizzle-kit push*)",
      "Bash(pnpm drizzle-kit push*)",
      "Bash(npx drizzle-kit push*)",
      "Bash(pnpx drizzle-kit push*)",
      "Bash(drizzle-kit push*)",
      "Bash(./node_modules/.bin/drizzle-kit push*)",
      "Bash(cat .env)",
      "Bash(cat ./.env)",
      "Bash(cat .env.local*)",
      "Bash(cat ./.env.local*)",
      "Bash(cat .env.production*)",
      "Bash(cat .env.development*)",
      "Bash(head .env)",
      "Bash(head ./.env)",
      "Bash(head .env.local*)",
      "Bash(head ./.env.local*)",
      "Bash(head .env.production*)",
      "Bash(head .env.development*)",
      "Bash(tail .env)",
      "Bash(tail ./.env)",
      "Bash(tail .env.local*)",
      "Bash(tail ./.env.local*)",
      "Bash(tail .env.production*)",
      "Bash(tail .env.development*)",
      "Bash(less .env)",
      "Bash(less ./.env)",
      "Bash(less .env.local*)",
      "Bash(less ./.env.local*)",
      "Bash(less .env.production*)",
      "Bash(less .env.development*)",
      "Bash(more .env)",
      "Bash(more ./.env)",
      "Bash(more .env.local*)",
      "Bash(more ./.env.local*)",
      "Bash(more .env.production*)",
      "Bash(more .env.development*)",
      "Bash(bat .env)",
      "Bash(bat ./.env)",
      "Bash(bat .env.local*)",
      "Bash(bat ./.env.local*)",
      "Bash(bat .env.production*)",
      "Bash(bat .env.development*)",
      "Bash(sed .env)",
      "Bash(sed ./.env)",
      "Bash(sed .env.local*)",
      "Bash(sed ./.env.local*)",
      "Bash(sed .env.production*)",
      "Bash(sed .env.development*)",
      "Bash(awk .env)",
      "Bash(awk ./.env)",
      "Bash(awk .env.local*)",
      "Bash(awk ./.env.local*)",
      "Bash(awk .env.production*)",
      "Bash(awk .env.development*)",
      "Bash(grep .env)",
      "Bash(grep ./.env)",
      "Bash(grep .env.local*)",
      "Bash(grep ./.env.local*)",
      "Bash(grep .env.production*)",
      "Bash(grep .env.development*)",
      "Bash(source .env)",
      "Bash(source ./.env)",
      "Bash(source .env.local*)",
      "Bash(source ./.env.local*)",
      "Bash(source .env.production*)",
      "Bash(source .env.development*)",
      "Bash(. .env)",
      "Bash(. ./.env)",
      "Bash(. .env.local*)",
      "Bash(. ./.env.local*)",
      "Bash(. .env.production*)",
      "Bash(. .env.development*)",
      "Bash(grep * .env)",
      "Bash(grep * ./.env)",
      "Bash(sed * .env)",
      "Bash(sed * ./.env)",
      "Bash(awk * .env)",
      "Bash(awk * ./.env)"
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "firecrawl@claude-plugins-official": true,
    "gsap-skills@gsap-skills": true
  },
  "extraKnownMarketplaces": {
    "gsap-skills": {
      "source": {
        "source": "github",
        "repo": "greensock/gsap-skills"
      }
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in *.ts|*.tsx|*.js|*.jsx|*.astro) pnpm exec prettier --write \"$f\" >/dev/null 2>&1; out=$(pnpm exec eslint --fix \"$f\" 2>&1) || { echo \"$out\" | tail -n 20 >&2; exit 2; } ;; esac"
          }
        ]
      }
    ]
  }
}
