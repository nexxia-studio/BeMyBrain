# Copier en .env et remplir. Aucune valeur réelle ici : les connexions viennent de la console Neon.

# Rôle propriétaire, branche Neon de l'environnement (dev en local) — migrations et seed uniquement, jamais lu par l'app.
DATABASE_URL=
# Rôle app_backend (LOGIN, sans BYPASSRLS), même branche — seule connexion utilisée par l'app.
DATABASE_AUTHENTICATED_URL=
# Rôle propriétaire, branche Neon test — prépare les données des tests d'isolation.
DATABASE_TEST_URL=
# Rôle app_backend, branche Neon test — exécute les assertions des tests d'isolation.
DATABASE_TEST_AUTHENTICATED_URL=
# URL de base Neon Auth de la branche de l'environnement (une par branche, ADR-003).
NEON_AUTH_BASE_URL=
# URL du JWKS Neon Auth de la même branche — vérifie la signature des jetons dans withUserDb.
NEON_AUTH_JWKS_URL=
# Hôte de l'endpoint de la branche production, sans -pooler — garde-fou local : drizzle-kit et Vitest refusent de viser cet hôte.
NEON_PRODUCTION_HOST=
# Identifiant (uuid) du compte Neon Auth propriétaire du workspace, sur la branche visée — lu par `pnpm db:seed` seulement.
SEED_OWNER_USER_ID=
