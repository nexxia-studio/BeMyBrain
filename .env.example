# Copier en .env et remplir. Aucune valeur réelle ici : les connexions viennent de la console Neon.

# Rôle propriétaire, branche Neon de l'environnement (dev en local) — migrations et seed uniquement, jamais lu par l'app.
DATABASE_URL=
# Rôle app_backend (LOGIN, sans BYPASSRLS), même branche — seule connexion utilisée par l'app.
DATABASE_AUTHENTICATED_URL=
# Rôle propriétaire, branche Neon test — prépare les données des tests d'isolation.
DATABASE_TEST_URL=
# Rôle app_backend, branche Neon test — exécute les assertions des tests d'isolation.
DATABASE_TEST_AUTHENTICATED_URL=
# URL de base Neon Auth de la branche de l'environnement (une par branche, ADR-003).
NEON_AUTH_BASE_URL=
# URL du JWKS Neon Auth de la même branche — vérifie la signature des jetons dans withUserDb.
NEON_AUTH_JWKS_URL=
# iss attendu des jetons Neon Auth de la branche = origine de NEON_AUTH_BASE_URL (https://hôte, sans chemin). Vérifié par withUserDb.
NEON_AUTH_ISSUER=
# aud attendue des jetons Neon Auth de la branche = la même origine que NEON_AUTH_ISSUER. Vérifiée par withUserDb.
NEON_AUTH_AUDIENCE=
# Secret de signature du cookie de cache de session du SDK @neon/auth (32 caractères minimum) : `openssl rand -base64 32`. Un par environnement.
NEON_AUTH_COOKIE_SECRET=
# Hôte de l'endpoint de la branche production, sans -pooler — garde-fou local : drizzle-kit et Vitest refusent de viser cet hôte.
NEON_PRODUCTION_HOST=
# Identifiant (uuid) du compte Neon Auth propriétaire du workspace, sur la branche visée — lu par `pnpm db:seed` seulement.
SEED_OWNER_USER_ID=
# Compte Neon Auth utilisé par les e2e connectés (pnpm e2e) : en local, un compte de la branche dev.
# Contre une preview (E2E_BASE_URL), seuls les comptes de `production` existent (les branches de preview en
# descendent) et la Deployment Protection de Vercel s'applique. Compte dédié : à décider par Antoine.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
# Optionnel : URL d'une preview HTTPS à viser par pnpm e2e (mobile en WebKit) ; défaut http://localhost:3000.
E2E_BASE_URL=
